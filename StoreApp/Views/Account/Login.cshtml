@model LoginModel

<div class="text-center my-5">
    <h6 class="display-6">
        <i class="fa-solid fa-right-to-bracket text-white bg-secondary p-3 rounded-5"></i>
        <br />
        Login
    </h6>
</div>

<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <div class="text-danger" asp-validation-summary="All"></div>

        <form method="post" asp-action="Login">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group my-3">
                <label asp-for="Name"></label>
                <input class="form-control" asp-for="Name" />
            </div>

            <div class="form-group my-3">
                <label asp-for="Password"></label>
                <input type="password" class="form-control" asp-for="Password" />
            </div>

            <div class="form-group my-3 d-flex justify-content-center">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    Login
                </button>
            </div>
        </form>

        <div>
            Don't have an account? Please head to the <a asp-action="Register">registration page</a>.
        </div>
    </div>
    <div class="col-md-3"></div>
</div>
