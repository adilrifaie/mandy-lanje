@model IEnumerable<Category>
<div class="text-center">
    <div class="display-6">Categories</div>

    <div class="d-flex justify-content-end my-3">
        <a class="btn btn-outline-success" asp-action="Create">
            <i class="fa fa-plus"></i>
            Create
        </a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Category Name</th>
                <th>Operations</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Category cat in Model)
            {
                <tr>
                    <td>@cat.CategoryId</td>
                    <td>@cat.CategoryName</td>
                    <td>
                        <div class="btn-group">
                            <a class="btn btn-warning" asp-action="Update" asp-route-id="@cat.CategoryId">
                                <i class="fa fa-edit"></i>
                                Edit</a>
                            <a class="btn btn-danger" asp-action="Delete" asp-route-id="@cat.CategoryId">
                                <i class="fa fa-trash"></i>
                                Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
